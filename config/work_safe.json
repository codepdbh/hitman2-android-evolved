{
  "_comment": "WORK_SAFE_MODE is the default profile. scripts/worksafe.py enforces these values; this file alone guarantees nothing.",
  "profile": "WORK_SAFE_MODE",
  "enabled": true,
  "headless_default": true,
  "allow_fullscreen_on_pc": false,
  "allow_window_focus_stealing": false,
  "allow_global_input_capture": false,
  "allow_display_mode_changes": false,
  "window_width": 800,
  "window_height": 450,
  "max_window_width": 960,
  "max_window_height": 540,
  "process_priority": "below_normal",
  "background_builds": true,
  "limit_parallel_jobs": true,
  "max_parallel_jobs_fraction": 0.25,
  "max_parallel_jobs": 4,
  "default_timeout_seconds": 900,
  "max_graphical_test_seconds": 60,
  "max_game_instances": 1,
  "allow_automatic_reboot": false,
  "show_modal_dialogs": false,
  "allow_original_game_launch": false,
  "interactive_test_mode": {
    "_comment": "INTERACTIVE_TEST_MODE: only via explicit H2_INTERACTIVE_TEST_MODE=1. Still windowed, still small, still no focus stealing on Windows.",
    "enabled": false,
    "headless_default": false,
    "allow_fullscreen_on_pc": false,
    "allow_window_focus_stealing": false,
    "allow_display_mode_changes": false,
    "max_window_width": 960,
    "max_window_height": 540
  }
}
